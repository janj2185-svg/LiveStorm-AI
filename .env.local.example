# =============================================================================
# SYLORA — host-mode local environment (no Docker required)
# =============================================================================
# Copy:
#   cp .env.local.example .env.local
#   cp .env.local.example services/api/.env
# Then run: ./setup-local.sh --host
#
# These values are SAFE LOCAL DEFAULTS for owner testing only.
# They are NOT production secrets. Change them if your machine is shared.
# =============================================================================

ENVIRONMENT=development
SERVICE_NAME=sylora-api
API_PREFIX=/v1

# --- Required local services ---
DATABASE_URL=postgresql+asyncpg://sylora:sylora_local_dev_only@127.0.0.1:5432/sylora
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Local-only secrets (generated by setup-local.sh --host if missing)
JWT_SECRET=47ae07333cefa3db86f4111a13f7f0c2819767cb06b6217902e2bcbb8ea31063
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=sylora-local
DATA_ENCRYPTION_KEY=3q5XyaAQcWdeg6hMB6JY5cocrwBWpR5UuzdOl-TaUls=
IP_HASH_KEY=4423f77a9278f35dee3989ea7e418ccfc4c57d49c609180e0a76b95876f29edb

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4317","http://127.0.0.1:4317"]
ALLOWED_HOSTS=["localhost","127.0.0.1","10.0.2.2"]
WEB_BASE_URL=http://localhost:5173

# Mail — without SMTP the API still stores verification tokens in EmailOutbox
# (seed script verifies accounts directly). Mailpit is preferred when Compose runs.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME="SYLORA Local"
SMTP_START_TLS=false
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Optional object storage (blank = Provider not configured / fail closed) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=900

# --- Optional AI / live / OAuth providers (blank = Provider not configured) ---
# OPENAI_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:8000/v1/live/integrations/oauth/callback
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://localhost:8000/v1/live/integrations/oauth/callback
# DISCORD_APPLICATION_ID=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/oauth/google/callback

# Media plane (Compose provides MediaMTX; host mode leaves blank)
MEDIAMTX_CONTROL_URL=
MEDIAMTX_CONTROL_USERNAME=
MEDIAMTX_CONTROL_PASSWORD=

SERVICE_HEALTH_HMAC_SECRET=

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
