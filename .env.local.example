# ─────────────────────────────────────────────────────────────────────────────
# SYLORA / LiveStorm AI — Local development environment
# Copy to repo root as `.env` and fill secrets.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# PostgreSQL (local recipe)
DATABASE_URL=postgresql://livestorm:livestorm_dev@127.0.0.1:5432/livestormdb

# TikTok — use demo for friend testing without a LIVE account
TIKTOK_MODE=demo
LIVE_PROVIDER=tiktools
TIKTOOL_API_KEY=

# Clerk (REQUIRED for web UI)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
VITE_CLERK_PROXY_URL=

# OpenAI (REQUIRED for AI + TTS)
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxx
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxx

# Owner admin bypass (must match your Clerk account email)
OWNER_EMAIL=you@example.com

# App
FRONTEND_URL=http://localhost:5173
API_RATE_LIMIT_PER_MIN=300
AI_RATE_LIMIT_PER_MIN=60

# Object storage (optional locally — avatar upload may need these)
PRIVATE_OBJECT_DIR=/tmp/livestorm-private
PUBLIC_OBJECT_SEARCH_PATHS=/tmp/livestorm-public

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# YouTube (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
