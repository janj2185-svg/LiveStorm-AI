# Copy to .env.local for friend testing (gitignored)
NODE_ENV=development
PORT=8080
LOCAL_DEV_AUTH=1

DATABASE_URL=postgresql://livestorm:livestorm_dev@127.0.0.1:5432/livestorm

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=pk_test_local_dev_bypass
VITE_LOCAL_DEV_AUTH=1
BASE_PATH=/
FRONTEND_PORT=23121

TIKTOK_MODE=demo
LIVE_PROVIDER=tiktools
TIKTOOL_API_KEY=

# Required for AI voice/chat (leave blank to browse UI without AI)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:23121/api/youtube/callback
FRONTEND_URL=http://localhost:23121
LOG_LEVEL=info
PRIVATE_OBJECT_DIR=/tmp/livestorm-private
PUBLIC_OBJECT_SEARCH_PATHS=/tmp/livestorm-public
