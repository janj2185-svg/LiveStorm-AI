SYLORA_ENV=development
DOMAIN=getsylora.com
API_PORT=8000
POSTGRES_DB=sylora
POSTGRES_USER=sylora
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me

# Shared BFF ↔ API secret (never expose to the browser)
INTERNAL_API_SECRET=dev-internal-secret-change-me

# Next.js → FastAPI (docker network hostname)
API_INTERNAL_URL=http://api:8000

# Optional LLM provider — without this key, Personal AI uses honest local companion replies
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Auth.js
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=https://getsylora.com
AUTH_TRUST_HOST=true

# Google OAuth (Authorized redirect URI: https://getsylora.com/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (Authorization callback URL: https://getsylora.com/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
