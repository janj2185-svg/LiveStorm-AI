# SYLORA Platform — local development

# Database (Docker Compose: infrastructure/dev/docker-compose.yml)
DATABASE_URL=postgresql://sylora:sylora@localhost:5433/sylora

# Redis
REDIS_URL=redis://localhost:6380/0

# JWT — generate: openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32-minimum-length

# API
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
