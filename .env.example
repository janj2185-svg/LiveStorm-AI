# =============================================================================
# SYLORA — root environment template (owner local testing)
# =============================================================================
# Copy to infrastructure/.env for Docker Compose:
#   cp .env.example infrastructure/.env
#   ./setup-local.sh          # generates secrets into infrastructure/.env
#
# Or for host-mode (no Docker): copy to .env.local and services/api/.env
#   cp .env.local.example .env.local
#   ./setup-local.sh --host
#
# NEVER commit real secrets. Values marked REPLACE_* must be generated locally.
# =============================================================================

# --- Required for local Docker Compose stack ---
COMPOSE_PROJECT_NAME=sylora
POSTGRES_DB=sylora
POSTGRES_USER=sylora
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_GENERATED_REDIS_PASSWORD
KAFKA_CLUSTER_ID=REPLACE_WITH_GENERATED_22_CHARACTER_KRAFT_ID
ELASTIC_PASSWORD=REPLACE_WITH_GENERATED_ELASTIC_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_GENERATED_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_MINIO_SECRET_KEY
JWT_SECRET=REPLACE_WITH_GENERATED_64_BYTE_JWT_SECRET
DATA_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
IP_HASH_KEY=REPLACE_WITH_GENERATED_SEPARATE_IP_HASH_KEY
GRAFANA_ADMIN_USER=sylora_grafana
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_GRAFANA_PASSWORD
STREAM_PUBLISH_USERNAME=sylora_publish
STREAM_PUBLISH_PASSWORD=REPLACE_WITH_GENERATED_STREAM_PUBLISH_PASSWORD
STREAM_READ_USERNAME=sylora_read
STREAM_READ_PASSWORD=REPLACE_WITH_GENERATED_STREAM_READ_PASSWORD
MEDIAMTX_API_USERNAME=sylora_mtx
MEDIAMTX_API_PASSWORD=REPLACE_WITH_GENERATED_MEDIAMTX_API_PASSWORD
TURN_REALM=sylora.local
TURN_USERNAME=sylora_turn
TURN_SECRET=REPLACE_WITH_GENERATED_TURN_SECRET
RECORDING_S3_ACCESS_KEY_ID=REPLACE_WITH_RECORDING_BUCKET_ACCESS_KEY
RECORDING_S3_SECRET_ACCESS_KEY=REPLACE_WITH_RECORDING_BUCKET_SECRET_KEY

# --- Local non-secret settings ---
ENVIRONMENT=development
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
API_WORKERS=2
API_LOG_LEVEL=info
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=sylora-local
API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4317"]
API_ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
WEB_BASE_URL=http://localhost:5173
SMTP_FROM_EMAIL=no-reply@sylora.local
OTEL_EXPORTER_OTLP_ENDPOINT=
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
TURN_PUBLIC_HOST=127.0.0.1
TURN_PUBLIC_IP=127.0.0.1
RECORDING_S3_PROVIDER=Minio
RECORDING_S3_ENDPOINT=http://minio:9000
RECORDING_S3_REGION=us-east-1
RECORDING_S3_BUCKET=sylora-recordings
RECORDING_S3_PREFIX=streams
RECORDING_UPLOAD_INTERVAL_SECONDS=30

# --- Optional external providers (leave blank = "Provider not configured") ---
# OPENAI_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# DISCORD_APPLICATION_ID=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Production-only (do not set for local owner testing) ---
# ENVIRONMENT=production
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# SERVICE_HEALTH_HMAC_SECRET=

# TikTok LIVE (blocked until approved provider)
TIKTOK_LIVE_PROVIDER_APPROVED=false
TIKTOK_LIVE_PROVIDER_NAME=
TIKTOK_LIVE_PROVIDER_API_KEY=
TIKTOK_LIVE_PROVIDER_ENDPOINT=

# Public multi-tester stand (staging only — never production)
TEST_STAND_MODE=false
TEST_STAND_AUTO_VERIFY_EMAIL=false
TEST_STAND_SANDBOX_WALLET=false
TEST_STAND_SANDBOX_CREDIT_MINOR=5000
TEST_STAND_ENDS_AT=
TEST_STAND_BUG_REPORT_URL=
