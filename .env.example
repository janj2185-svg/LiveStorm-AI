# SYLORA Platform — local development

DATABASE_URL=postgresql://sylora:sylora@localhost:5433/sylora
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-use-openssl-rand-hex-32-minimum-length

APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/v1/ws/notifications

# Email (optional in dev — logs to console; required in production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@sylora.app

# Media — local dev storage (default)
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=storage/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/v1/media/files

# S3 (production)
# MEDIA_STORAGE=s3
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_REGION=auto

# First admin account (gets admin role on register)
# ADMIN_BOOTSTRAP_EMAIL=you@example.com
