# ─────────────────────────────────────────────────────────────────────────────
# LiveStorm AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.
# For a fuller local template see .env.local.example
# ─────────────────────────────────────────────────────────────────────────────

# ── TikTok mode ───────────────────────────────────────────────────────────────
# "real"  → connects to actual TikTok LIVE (requires provider key)
# "demo"  → built-in simulator, no real TikTok needed (safe for staging)
TIKTOK_MODE=demo

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://livestorm:livestorm_dev@127.0.0.1:5432/livestormdb

# ── Clerk authentication ───────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Owner admin email (must match your Clerk login email)
OWNER_EMAIL=you@example.com

# ── OpenAI ────────────────────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe (optional — leave blank if not using billing) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

FRONTEND_URL=http://localhost:5173
