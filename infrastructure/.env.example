# Copy to infrastructure/.env and replace every REPLACE_WITH_GENERATED value.
# Generate passwords with: openssl rand -base64 32
# Generate JWT_SECRET with: openssl rand -hex 64
# Generate KAFKA_CLUSTER_ID with the Python command documented in README.md.
# Generate URL-safe streaming and TURN secrets with: openssl rand -hex 32

COMPOSE_PROJECT_NAME=sylora
POSTGRES_DB=sylora
POSTGRES_USER=sylora
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_GENERATED_REDIS_PASSWORD
KAFKA_CLUSTER_ID=REPLACE_WITH_GENERATED_22_CHARACTER_KRAFT_ID
ELASTIC_PASSWORD=REPLACE_WITH_GENERATED_ELASTIC_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_GENERATED_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_GENERATED_MINIO_SECRET_KEY
JWT_SECRET=REPLACE_WITH_GENERATED_64_BYTE_JWT_SECRET
DATA_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
IP_HASH_KEY=REPLACE_WITH_GENERATED_SEPARATE_IP_HASH_KEY
GRAFANA_ADMIN_USER=REPLACE_WITH_GENERATED_GRAFANA_USERNAME
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_GRAFANA_PASSWORD
STREAM_PUBLISH_USERNAME=REPLACE_WITH_GENERATED_STREAM_PUBLISH_USERNAME
STREAM_PUBLISH_PASSWORD=REPLACE_WITH_GENERATED_STREAM_PUBLISH_PASSWORD
STREAM_READ_USERNAME=REPLACE_WITH_GENERATED_STREAM_READ_USERNAME
STREAM_READ_PASSWORD=REPLACE_WITH_GENERATED_STREAM_READ_PASSWORD
MEDIAMTX_API_USERNAME=REPLACE_WITH_GENERATED_MEDIAMTX_API_USERNAME
MEDIAMTX_API_PASSWORD=REPLACE_WITH_GENERATED_MEDIAMTX_API_PASSWORD
TURN_REALM=REPLACE_WITH_TURN_REALM
TURN_USERNAME=REPLACE_WITH_GENERATED_TURN_USERNAME
TURN_SECRET=REPLACE_WITH_GENERATED_TURN_SECRET
RECORDING_S3_ACCESS_KEY_ID=REPLACE_WITH_RECORDING_BUCKET_ACCESS_KEY
RECORDING_S3_SECRET_ACCESS_KEY=REPLACE_WITH_RECORDING_BUCKET_SECRET_KEY

# Local, non-secret settings.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
API_WORKERS=2
API_LOG_LEVEL=info
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=sylora-local
API_CORS_ORIGINS=["http://localhost:5173"]
API_ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
WEB_BASE_URL=http://localhost:5173
SMTP_FROM_EMAIL=no-reply@example.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# Use actual LAN/public addresses for cross-device WebRTC and TURN tests.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
TURN_PUBLIC_HOST=127.0.0.1
TURN_PUBLIC_IP=127.0.0.1

# The local uploader targets the private MinIO bucket created by Compose.
RECORDING_S3_PROVIDER=Minio
RECORDING_S3_ENDPOINT=http://minio:9000
RECORDING_S3_REGION=us-east-1
RECORDING_S3_BUCKET=sylora-recordings
RECORDING_S3_PREFIX=streams
RECORDING_UPLOAD_INTERVAL_SECONDS=30
