# Optional Cloudflare DNS-01 ACME (needed when orange-cloud proxy is on).
# Build: docker build -f Dockerfile.caddy -t sylora-caddy:production .
FROM caddy:2.8-builder-alpine AS builder
RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare

FROM caddy:2.8-alpine
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
