# SYLORA production — NEVER commit the filled .env
# Host: Hetzner Ubuntu 24.04 | DNS: Cloudflare | Objects: Cloudflare R2 (S3 API)

# --- Public identity ---
DOMAIN=app.example.com
ACME_EMAIL=owner@example.com
# Optional: Cloudflare API token with Zone.DNS Edit for DNS-01 (orange-cloud).
# Leave empty to use HTTP-01 (set Cloudflare SSL to Full and DNS record DNS-only until cert issues).
CLOUDFLARE_API_TOKEN=
CADDY_IMAGE=sylora-caddy:production
CADDY_CONFIG_FILE=/etc/caddy/Caddyfile

# --- App mode ---
# production = real SMTP required, no test-stand flags
# staging    = allowed for public beta with TEST_STAND_* (production-grade hardware)
APP_ENVIRONMENT=production
IMAGE_TAG=production
JWT_AUDIENCE=sylora-api
API_WORKERS=2
API_LOG_LEVEL=info

# --- Database / Redis ---
POSTGRES_DB=sylora
POSTGRES_USER=sylora
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_MAXMEMORY=512mb

# --- Crypto ---
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM
DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
IP_HASH_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM

# --- SMTP (required when APP_ENVIRONMENT=production) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=SYLORA
SMTP_START_TLS=true
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Cloudflare R2 / S3-compatible object storage ---
# Example R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=sylora-app
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
S3_PRESIGN_SECONDS=900

# --- Backups (defaults to app R2 bucket/credentials if unset) ---
BACKUP_S3_BUCKET=sylora-backups
BACKUP_S3_PREFIX=postgres/sylora
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=21600

# --- Optional AI ---
OPENAI_API_KEY=

# --- Auth OAuth (optional; missing provider → oauth_provider_unavailable) ---
# Canonical keys. Aliases also accepted by the API:
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#   GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET
#   APPLE_CLIENT_ID / APPLE_CLIENT_SECRET
#   AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET (NextAuth-style)
#   AUTH_GITHUB_ID / AUTH_GITHUB_SECRET
# Discovery URL + redirect URI default when omitted:
#   Google → accounts.google.com OIDC discovery
#   Apple  → appleid.apple.com OIDC discovery
#   GitHub → builtin:github (GitHub has no public login OIDC discovery)
# Default redirect: https://$DOMAIN/v1/auth/oauth/{provider}/callback
# Register that exact callback in each provider console.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# OAUTH_GOOGLE_REDIRECT_URI=https://getsylora.com/v1/auth/oauth/google/callback
# OAUTH_GOOGLE_SCOPES=openid email profile
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITHUB_DISCOVERY_URL=builtin:github
# OAUTH_GITHUB_REDIRECT_URI=https://getsylora.com/v1/auth/oauth/github/callback
# OAUTH_GITHUB_SCOPES=read:user user:email
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_APPLE_DISCOVERY_URL=https://appleid.apple.com/.well-known/openid-configuration
# OAUTH_APPLE_REDIRECT_URI=https://getsylora.com/v1/auth/oauth/apple/callback
# OAUTH_APPLE_SCOPES=openid email name

# --- Public beta helpers (only when APP_ENVIRONMENT=staging) ---
# For production APP_ENVIRONMENT these must stay false.
TEST_STAND_MODE=false
TEST_STAND_AUTO_VERIFY_EMAIL=false
TEST_STAND_SANDBOX_WALLET=false
TEST_STAND_SANDBOX_CREDIT_MINOR=5000
TEST_STAND_ENDS_AT=
TEST_STAND_BUG_REPORT_URL=https://github.com/janj2185-svg/LiveStorm-AI/issues
BOOTSTRAP_SOFT_PING=false
