# Example nginx upstream switch for getsylora.com cutover.
# Copy into the CURRENT dashboard nginx container's network path ONLY after
# parallel stack verification. Prefer joining restored containers to the
# existing sylora_default network and pointing upstreams at them.
#
# Rollback: restore infrastructure/nginx/default.conf from the pre-cutover backup.

map $http_x_forwarded_proto $sylora_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# After: docker network connect sylora_default sylora-restored-api-1
#        docker network connect sylora_default sylora-restored-web-preview-1
upstream sylora_frontend {
    server sylora-restored-web-preview-1:80;
}

upstream sylora_api {
    server sylora-restored-api-1:8000;
}

server {
    listen 80;
    listen [::]:80;
    server_name getsylora.com www.getsylora.com 46.225.84.210 _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location /health {
        proxy_pass http://sylora_api/health/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $sylora_forwarded_proto;
    }

    location /health/ {
        proxy_pass http://sylora_api/health/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $sylora_forwarded_proto;
    }

    location /v1/ {
        proxy_pass http://sylora_api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $sylora_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
    }

    location / {
        proxy_pass http://sylora_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $sylora_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name getsylora.com www.getsylora.com 46.225.84.210 _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location /health {
        proxy_pass http://sylora_api/health/ready;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $sylora_forwarded_proto;
    }

    location /health/ {
        proxy_pass http://sylora_api/health/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $sylora_forwarded_proto;
    }

    location /v1/ {
        proxy_pass http://sylora_api/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $sylora_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
    }

    location / {
        proxy_pass http://sylora_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $sylora_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
