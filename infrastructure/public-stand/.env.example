# SYLORA public test stand — NEVER commit the filled .env
STAND_DOMAIN=stand.example.com
ACME_EMAIL=owner@example.com

POSTGRES_DB=sylora
POSTGRES_USER=sylora
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM
DATA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
IP_HASH_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM

# Optional SMTP (preferred). If unset, keep auto-verify for stand registration.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_START_TLS=true

TEST_STAND_AUTO_VERIFY_EMAIL=true
TEST_STAND_SANDBOX_WALLET=true
TEST_STAND_SANDBOX_CREDIT_MINOR=5000
TEST_STAND_ENDS_AT=2026-08-15
TEST_STAND_BUG_REPORT_URL=https://github.com/janj2185-svg/LiveStorm-AI/issues

# Real payments must stay off unless separately confirmed.
# Do not set Stripe keys for the public stand without explicit owner approval.
