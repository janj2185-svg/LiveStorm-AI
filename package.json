{
  "name": "sylora-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev:web": "pnpm --filter @sylora/web dev",
    "build:web": "pnpm --filter @sylora/web build",
    "test:web": "pnpm --filter @sylora/web test",
    "test:ui": "pnpm --filter @sylora/ui test",
    "test:platform": "pnpm test:ui && pnpm test:web",
    "lint:web": "pnpm --filter @sylora/web lint",
    "verify:phase0": "./scripts/verify-phase0.sh"
  }
}
