{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "desktop:dev": "pnpm --filter @workspace/desktop run dev",
    "desktop:build": "pnpm --filter @workspace/desktop run build:desktop",
    "desktop:build:win": "pnpm --filter @workspace/desktop run build:desktop:win",
    "desktop:build:mac": "pnpm --filter @workspace/desktop run build:desktop:mac",
    "desktop:build:linux": "pnpm --filter @workspace/desktop run build:desktop:linux",
    "local:seed": "pnpm --filter @workspace/api-server exec tsx src/scripts/seed-demo-users.ts",
    "local:api": "pnpm --filter @workspace/api-server run dev",
    "local:web": "PORT=5173 BASE_PATH=/ pnpm --filter @workspace/livestorm-ai run dev",
    "test:api": "pnpm --filter @workspace/api-server run test"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "stripe": "^22.2.0",
    "stripe-replit-sync": "^1.0.0"
  }
}
