# Local listener. Non-loopback values are refused unless every LAN control is set.
BIND_HOST=127.0.0.1
BIND_PORT=8765
ALLOW_LAN=false
TLS_CERT=
TLS_KEY=
LAN_CIDRS=
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
CORS_ORIGIN=http://127.0.0.1:5173

# OBS Studio 28+ ships OBS WebSocket 5.x on port 4455.
OBS_WS_URL=ws://127.0.0.1:4455
OBS_WS_PASSWORD=
OBS_REQUEST_TIMEOUT=8
OBS_PENDING_LIMIT=128
OBS_EVENT_SUBSCRIPTIONS=4294967295

# Optional outbound-only SYLORA pairing. Both URLs must be configured together.
CLOUD_API_URL=
CLOUD_WS_URL=
CLOUD_CAPABILITIES=
CONFIRMATION_ACTIONS=stream.start,stream.stop,record.start,record.stop,virtual_camera.start,virtual_camera.stop
CONFIRMATION_TIMEOUT=30

# Optional signed updater. UPDATE_PUBLIC_KEY is a raw Ed25519 key in base64 or hex.
UPDATE_MANIFEST_URL=
UPDATE_PUBLIC_KEY=

STATE_DIR=~/.local/share/sylora-companion
BODY_LIMIT_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
