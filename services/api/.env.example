# Copy this file to .env and replace every CHANGE_ME value.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://sylora:CHANGE_ME@127.0.0.1:5432/sylora
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=https://api.sylora.example
JWT_AUDIENCE=sylora-api
DATA_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
IP_HASH_KEY=CHANGE_ME_SEPARATE_HIGH_ENTROPY_KEY
CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1","10.0.2.2"]
WEB_BASE_URL=http://localhost:5173

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=SYLORA
SMTP_START_TLS=false
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional real S3-compatible gift, creator-content, marketplace, business
# document, AI-output, and certificate storage. Leaving these blank makes
# upload verification and download/rendered-output storage return
# object_storage_unavailable.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_SECONDS=900

# Redis-backed wallet/gift abuse controls.
WALLET_RATE_WINDOW_SECONDS=60
PURCHASE_RATE_LIMIT=20
GIFT_SEND_RATE_LIMIT=30
TOPUP_RATE_LIMIT=5

# Creator subscription, marketplace, progress, and quiz abuse controls.
PLATFORM_RATE_WINDOW_SECONDS=60
CREATOR_SUBSCRIPTION_RATE_LIMIT=10
MARKETPLACE_CHECKOUT_RATE_LIMIT=10
MARKETPLACE_REVIEW_RATE_LIMIT=30
LEARNING_PROGRESS_RATE_LIMIT=120
LEARNING_QUIZ_RATE_LIMIT=60
BUSINESS_MUTATION_RATE_LIMIT=120
ADMIN_MUTATION_RATE_LIMIT=60

# Optional HMAC authentication for application-submitted service health
# reports. Leaving this blank disables ingestion.
SERVICE_HEALTH_HMAC_SECRET=
SERVICE_HEALTH_MAX_CLOCK_SKEW_SECONDS=300

# No payment processor is bundled. A real PaymentProvider implementation must
# be injected by the deployment; unconfigured payment APIs fail closed.
# No content processor or certificate PDF renderer is bundled. Those provider
# boundaries must also be injected; no local processing fallback exists.

# Consumer OAuth for the public product (Flutter UI):
# Google, Apple, Facebook, TikTok. GitHub is NOT a product sign-in option
# (local development/test tooling only — never staging/production).
# Callbacks must be HTTPS in staging/production and match the provider console:
#   {WEB_BASE_URL}/v1/auth/oauth/{provider}/callback
# Placeholder client ids/secrets (changeme, example, todo, …) are rejected.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=https://getsylora.com/v1/auth/oauth/google/callback
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_APPLE_REDIRECT_URI=https://getsylora.com/v1/auth/oauth/apple/callback
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=https://getsylora.com/v1/auth/oauth/facebook/callback
# OAUTH_TIKTOK_CLIENT_ID=
# OAUTH_TIKTOK_CLIENT_SECRET=
# OAUTH_TIKTOK_REDIRECT_URI=https://getsylora.com/v1/auth/oauth/tiktok/callback

# SMS OTP (phone auth + phone password recovery). Unset => phone auth unavailable.
# SMS_PROVIDER=twilio   # or vonage
# SMS_API_KEY=
# SMS_API_SECRET=
# SMS_ACCOUNT_SID=
# SMS_FROM_NUMBER=+15551234567
# PHONE_DEFAULT_REGION=UA

# SYLORA AI Live Hub. No platform credential is bundled. OAuth client settings
# enable the official authorization boundary; each user's tokens are encrypted.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:8000/v1/live/integrations/oauth/callback
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://localhost:8000/v1/live/integrations/oauth/callback
# DISCORD_APPLICATION_ID=

# MediaMTX is the first-party RTMP/WebRTC media plane. The URL is deployment
# configuration, never accepted from API requests. Production requires HTTPS.
# MEDIAMTX_CONTROL_URL=
# MEDIAMTX_CONTROL_USERNAME=
# MEDIAMTX_CONTROL_PASSWORD=

# OBS request endpoints must match this explicit companion allowlist. ws:// is
# accepted only for a loopback/private local companion host in this list.
LIVE_OBS_ALLOWED_HOSTS=["127.0.0.1","::1","localhost"]

# Plugin manifests require an allowlisted HTTPS host and an allowlisted Ed25519
# public key (base64 raw key), keyed by manifest signing_key_id.
LIVE_PLUGIN_ALLOWED_HOSTS=[]
LIVE_PLUGIN_SIGNING_KEYS={}

# TikTok LIVE (blocked until approved provider)
TIKTOK_LIVE_PROVIDER_APPROVED=false
TIKTOK_LIVE_PROVIDER_NAME=
TIKTOK_LIVE_PROVIDER_API_KEY=
TIKTOK_LIVE_PROVIDER_ENDPOINT=

# Public multi-tester stand (staging only — never production)
TEST_STAND_MODE=false
TEST_STAND_AUTO_VERIFY_EMAIL=false
TEST_STAND_SANDBOX_WALLET=false
TEST_STAND_SANDBOX_CREDIT_MINOR=5000
TEST_STAND_ENDS_AT=
TEST_STAND_BUG_REPORT_URL=
